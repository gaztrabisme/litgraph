# Copy to .env and fill in. Load with:  set -a; source .env; set +a

# Local oMLX server (OpenAI-compatible MLX server on Apple Silicon).
# Serves the local chat/adjudication model and the embedding model.
OMLX_BASE_URL=http://127.0.0.1:8000/v1
OMLX_API_KEY=

# DeepSeek API — used for extraction volume and as the second critic family.
DEEPSEEK_API_KEY=
